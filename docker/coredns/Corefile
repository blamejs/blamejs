# CoreDNS config: plain DNS (53/udp+tcp), DoT (853/tcp) and DoH
# (443/tcp, published on 8053) for the lib/network-dns.js integration
# tests.
#
# CoreDNS answers from the local zone below and forwards nothing, so the
# test stack resolves without outbound DNS, DoT (853) or DoH. Every name
# outside the zone gets NXDOMAIN. The addresses are the IANA-held
# example.com addresses, which b.ssrfGuard classifies as public.

(testzone) {
    hosts {
        93.184.215.14 example.com
        2606:2800:21f:cb07:6820:80da:af6b:8b2c example.com
    }
    errors
}

. {
    bind 0.0.0.0 ::
    import testzone
    health :8054
    ready :8055
}

tls://. {
    bind 0.0.0.0 ::
    tls /certs/coredns.crt /certs/coredns.key
    import testzone
}

https://. {
    bind 0.0.0.0 ::
    tls /certs/coredns.crt /certs/coredns.key
    import testzone
}
